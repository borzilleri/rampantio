<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ tagline or site.description }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23121319'/><circle cx='16' cy='16' r='6' fill='%23e3a367'/></svg>">
<script>
/* Pre-paint half of the theme toggle: a dark-mode reload must never flash
   light, so this runs before the stylesheet. The rest is in assets/js/shell.js
   — keep the 'theme' key and the light/dark values in sync with it. */
try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}
</script>
<link rel="stylesheet" href="{{ '/assets/css/base.css' | url }}">
{%- for href in styles %}
<link rel="stylesheet" href="{{ href | url }}">
{%- endfor %}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href="{{ '/' | url }}">rampant<span class="wordmark__dot">.</span>io</a>
    {%- if breadcrumb or title %}
    <nav class="crumb" aria-label="Breadcrumb"><span class="crumb__sep" aria-hidden="true">/</span><span>{{ breadcrumb or title }}</span></nav>
    {%- endif %}
    <button class="mode" type="button" data-theme-toggle aria-live="polite">Auto</button>
  </div>
</header>

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <span>&copy; {{ year }} {{ site.author }}</span>
    <a href="{{ '/' | url }}">Home</a>
  </div>
</footer>

<script src="{{ '/assets/js/shell.js' | url }}" defer></script>
{%- for src in scripts %}
<script src="{{ src | url }}" defer></script>
{%- endfor %}
</body>
</html>
